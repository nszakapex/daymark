{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build:demo",
  "outputDirectory": "dist/public-demo",
  "rewrites": [
    {
      "source": "/api/sample-check",
      "destination": "/api/public-sample-check"
    },
    {
      "source": "/demo",
      "destination": "/index.html"
    },
    {
      "source": "/sample-store",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://acregrowthservices.com https://www.acregrowthservices.com https://*.vercel.app"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
